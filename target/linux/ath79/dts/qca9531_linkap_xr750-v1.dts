/dts-v1/;

#include "qca953x.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "linkap,xr750-v1", "qca,qca9531";
	model = "LinkAP XR750 V1";

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	aliases {
		serial0 = &uart;
		led-boot = &led_system;
		led-failsafe = &led_system;
		led-running = &led_system;
		led-upgrade = &led_system;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x4000000>; /* 64 MB */
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "Reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_system: system {
			label = "linkap:white:system";
			gpios = <&gpio 12 GPIO_ACTIVE_LOW>;
		};

		game {
			label = "linkap:green:game";
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
		};

		wan {
			label = "linkap:white:wan";
			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
		};
	};
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			factory: partition@40000 {
				label = "factory";
				reg = <0x040000 0x010000>;
				read-only;

				compatible = "nvmem-cells";
                		#address-cells = <1>;
                		#size-cells = <1>;

                		macaddr_factory_10: macaddr@10 {
                    			reg = <0x10 0x6>;
                		};
			};

			/* firmware 容器，包含 kernel + rootfs，总大小 0xF40000 (15616 KB) */
			partition@50000 {
				label = "firmware";
				reg = <0x050000 0xf40000>;
				compatible = "denx,uimage";
			};

			partition@f90000 {
				label = "backup";
				reg = <0xf90000 0x060000>;
			};

			art: partition@ff0000 {
				label = "art";
				reg = <0xff0000 0x010000>;
				read-only;
			};
		};
	};
};

&eth0 {
	status = "okay";

	phy-handle = <&swphy4>;
	mtd-mac-address = <&factory 0x10>;
};

&eth1 {
	status = "okay";

	phy-mode = "gmii";
	mtd-mac-address = <&factory 0x16>;

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio1 {
	status = "okay";

	builtin_switch: switch0@1f {
		compatible = "qca,ar8229";
		reg = <0x1f>;
		phy-mode = "gmii";
		qca,phy4-mii-enable;

		mdio-bus {
			#address-cells = <1>;
			#size-cells = <0>;

			swphy0: ethernet-phy@0 {
				reg = <0>;
			};

			swphy1: ethernet-phy@1 {
				reg = <1>;
			};

			swphy2: ethernet-phy@2 {
				reg = <2>;
			};

			swphy3: ethernet-phy@3 {
				reg = <3>;
			};

			swphy4: ethernet-phy@4 {
				reg = <4>;
			};
		};
	};
};

&wmac {
	status = "okay";

	mtd-cal-data = <&art 0x1000>;
	/* 修正：基于 factory hex dump 数据，2.4G 无线 MAC 地址位于偏移量 0x1c 处 */
	mtd-mac-address = <&factory 0x1c>;
};

&pcie0 {
	status = "okay";

	wifi@0,0 {
		compatible = "pci168c,0050";
		reg = <0x0000 0 0 0 0>;
		qcom,ath10k-calibration-variant = "XR750";
		mtd-cal-data = <&art 0x5000>;
		mtd-mac-address = <&factory 0x1c>;
                mac-address-increment = <1>;
	};
};

&usb_phy {
	status = "okay";
};

&usb0 {
	status = "okay";
};
